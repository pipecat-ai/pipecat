# Tier 0 (softphone <-> bot, Daily-only) needs this block.
DAILY_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Tier 1 (real phones via a Twilio Elastic SIP trunk) adds this block.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_CALLER_ID=   # only if your Twilio number isn't attached to the trunk

# SIP transport reference (see TESTING.md for the full table).
# SIP_TRANSPORT=udp          # udp (default) or tcp
# SIP_NATIVE_LOG_LEVEL=warning   # baresip's own log verbosity
# SIP_TRACE=1                # full SIP packet trace; carries auth material, never commit
