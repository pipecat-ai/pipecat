# Tier 1 and 2 (softphone <-> bot on your Daily domain) need this block.
DAILY_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Tier 3 (real phones via a Twilio Elastic SIP trunk) adds this block.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
#TWILIO_CALLER_ID=   # only if your Twilio number isn't attached to the trunk

# Tier 4 (Daily sip_client trunk) needs the trunk's notification.hmac.
#SIP_TRUNK_HMAC=

# SIP transport reference (full table in README.md).
#SIP_TRANSPORT=tls              # udp, tcp or tls; tls for a provisioned client
#SIP_DIALOUT_URI=               # dial this URI on start, instead of a runner body
#SIP_REG_INTERVAL=600           # registration refresh seconds; 0 is trunk mode
#SIP_AUTH_USER=                 # digest username, when it differs from the AOR
#SIP_INSTANCE_ID=               # stable UUID, so a restart replaces its binding
#SIP_EXTRA_PARAMS=              # raw baresip account params, comma-separated
#SIP_STUN_SERVER=off            # disable media-NAT traversal; trunk dial-out needs it
#SIP_NATIVE_LOG_LEVEL=warning   # baresip's own log verbosity
#SIP_TRACE=1                    # full SIP packet trace; carries auth material, never commit
