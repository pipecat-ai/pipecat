{
  "name": "{{ project_name }}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
{%- for name, version in ui_dependencies.items() %}
    "{{ name }}": "{{ version }}",
{%- endfor %}
    "@fontsource-variable/geist": "^5.3.0",
{%- for transport in transports %}
{%- if transport.value == 'daily' %}
    "@pipecat-ai/daily-transport": "^1.6.8",
{%- elif transport.value == 'smallwebrtc' %}
    "@pipecat-ai/small-webrtc-transport": "^1.10.7",
{%- elif transport.value == 'websocket' %}
    "@pipecat-ai/websocket-transport": "^1.7.1",
{%- endif %}
{%- endfor %}
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.0.16"
  }
}
